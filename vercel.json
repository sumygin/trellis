{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "privacy.html", "use": "@vercel/static" },
    { "src": "terms.html", "use": "@vercel/static" },
    { "src": "favicon.png", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "api/config.py", "use": "@vercel/python" },
    { "src": "api/board.py", "use": "@vercel/python" },
    { "src": "api/boards.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/config", "dest": "/api/config.py" },
    { "src": "/api/board", "dest": "/api/board.py" },
    { "src": "/api/boards", "dest": "/api/boards.py" },
    { "src": "/privacy/?", "dest": "/privacy.html" },
    { "src": "/terms/?", "dest": "/terms.html" },
    { "src": "/favicon.png", "dest": "/favicon.png" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
